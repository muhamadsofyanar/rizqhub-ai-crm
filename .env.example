# WAJIB: buat nilai acak yang kuat
DJANGO_SECRET_KEY=change-me-use-random-64-chars
POSTGRES_PASSWORD=change-me-database-password
APP_ENCRYPTION_KEY=change-me-fernet-key
ADMIN_EMAIL=admin@domainanda.com
ADMIN_PASSWORD=change-me-admin-password

# Domain produksi
APP_BASE_URL=https://crm.domainanda.com
ALLOWED_HOSTS=crm.domainanda.com
CSRF_TRUSTED_ORIGINS=https://crm.domainanda.com

# AI (opsional; pilih Gemini atau OpenAI)
# auto: memakai Gemini bila GEMINI_API_KEY terisi, lalu fallback ke OpenAI
AI_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
AUTO_REPLY_DEFAULT=false

# Tuning VPS 4 core / 8 GB
WEB_CONCURRENCY=3
CELERY_CONCURRENCY=2
DJANGO_DEBUG=false
POSTGRES_DB=rizqhub
POSTGRES_USER=rizqhub

# Feature flags: aktifkan bertahap di produksi
FEATURE_LIVE_INBOX=true
FEATURE_MESSAGE_RETRY=true
FEATURE_AI_EVALUATION=true
FEATURE_AUTOMATION=false
FEATURE_CAMPAIGN=false
FEATURE_SAAS=false
FEATURE_BACKUP=true
LIVE_INBOX_POLL_SECONDS=2.5
CAMPAIGN_MAX_RECIPIENTS=500
WEBHOOK_RATE_LIMIT_PER_MINUTE=180
BACKUP_RETENTION_DAYS=14
BACKUP_HOUR=2
SECURE_HSTS_SECONDS=0
