# WAJIB: buat nilai acak yang kuat
DJANGO_SECRET_KEY=change-me-use-random-64-chars
POSTGRES_PASSWORD=change-me-database-password
APP_ENCRYPTION_KEY=change-me-fernet-key
ADMIN_EMAIL=admin@domainanda.com
ADMIN_PASSWORD=change-me-admin-password

# Domain produksi
APP_BASE_URL=https://crm.domainanda.com
ALLOWED_HOSTS=crm.domainanda.com
CSRF_TRUSTED_ORIGINS=https://crm.domainanda.com

# AI (opsional; tanpa ini aplikasi tetap berjalan, AI test tidak aktif)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
AUTO_REPLY_DEFAULT=false

# Tuning VPS 4 core / 8 GB
WEB_CONCURRENCY=3
CELERY_CONCURRENCY=2
DJANGO_DEBUG=false
POSTGRES_DB=rizqhub
POSTGRES_USER=rizqhub
